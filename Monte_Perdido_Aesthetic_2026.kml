  <Document>
    <name>Monte Perdido - Hiking Aesthetic 2026</name>
    <open>1</open>
    
    <Style id="neonRedRoute">
      <LineStyle>
        <color>ff4422ff</color>
        <width>6</width>
      </LineStyle>
    </Style>

    <Style id="cameraSlide">
      <IconStyle>
        <scale>0.0</scale>
      </IconStyle>
      <LabelStyle>
        <scale>0.0</scale> <!-- Ocultar texto "Tramo" en pantalla -->
      </LabelStyle>
    </Style>

    <Style id="pinStyle">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Marcadores de Puntos Clave Principales -->
    <Placemark>
      <name>Pradera de Ordesa (1.300m)</name>
      <styleUrl>#pinStyle</styleUrl>
      <Point>
        <coordinates>{points[0]['lon']},{points[0]['lat']},{points[0]['ele']}</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>MONTE PERDIDO (3.355m)</name>
      <styleUrl>#pinStyle</styleUrl>
      <Point>
        <coordinates>{max(points, key=lambda p: p['ele'])['lon']},{max(points, key=lambda p: p['ele'])['lat']},{max(points, key=lambda p: p['ele'])['ele']}</coordinates>
      </Point>
    </Placemark>

